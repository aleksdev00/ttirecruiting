# ---------------------------------------------------------------------------
# TTI Recruiting -- production environment variables
# Copy to .env.local (or set in your host) before deploy. No secrets here.
# ---------------------------------------------------------------------------

# Canonical production domain. Overrides SITE_URL in src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://ttirecruiting.us

# Full driver application (kept separate from the marketing site).
# Overrides FULL_APPLICATION_URL in src/lib/site.ts.
NEXT_PUBLIC_FULL_APPLICATION_URL=https://apply.ttirecruiting.us

# Server-only admin and catalog configuration. Leave unset until the identity
# provider, immutable subject IDs, and authoritative catalog store are verified.
TTI_AUTH_PROVIDER=
TTI_ADMIN_SUBJECT_IDS=
TTI_CATALOG_DATABASE_URL=
TTI_CATALOG_SOURCE_READ_TOKEN=
TTI_INTAKE_STAGING_ENDPOINT=
